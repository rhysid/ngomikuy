<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bookmark - Ngomikuy</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-left">
                   <a href="/" class="logo">
    <img src="/ngomikuy.png" alt="Ngomikuy" class="logo-img">
</a>
        </div>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/pustaka">Pustaka</a></li>
            <li><a href="/genre">Genre</a></li>
            <li><a href="/bookmark" class="active">Bookmark</a></li>
            <li><a href="/support">Support</a></li>
        </ul>
        <div class="nav-right">
            <button class="icon-btn"><i class="fas fa-search"></i></button>
            <a href="/member/dashboard" class="icon-btn"><i class="far fa-user"></i></a>
            <button class="icon-btn menu-btn"><i class="fas fa-bars"></i></button>
        </div>
    </nav>

    <!-- KONTEN BOOKMARK -->
    <div class="container" style="margin-top: 40px;">
        <div class="section-header-flex" style="margin-bottom: 30px;">
            <h3><i class="fas fa-bookmark" style="color: var(--accent-green);"></i> Komik Favorit Saya</h3>
        </div>

        <!-- Wadah List Bookmark yang dirender via JS -->
        <div id="bookmarkContainer" class="pustaka-list">
            <!-- Data akan dimasukkan otomatis lewat script di bawah -->
        </div>
    </div>

    <!-- FOOTER -->
  <footer class="site-footer">
            <div class="footer-logo">
            <img src="/Ngomikuy.png" alt="Ngomikuy" class="logo-img">
        </div>
            <p class="footer-tagline">Read Comics, manga, manhua, manhwa, translated swiftly: Ngomikuy, your ultimate library.</p>
            <a href="/contact" class="footer-contact">Contact us</a>
            
            <hr class="footer-divider">
            
            <div class="footer-bottom">
                <p><i class="fas fa-heart"></i> Made by Ngomikuy</p>
                <p>&copy; 2026 All Rights Reserved</p>
            </div>
        </footer>

    <!-- SKRIP RENDER BOOKMARK DARI LOCALSTORAGE -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const container = document.getElementById('bookmarkContainer');
            const bookmarks = JSON.parse(localStorage.getItem('yuu_bookmarks')) || [];

            if (bookmarks.length === 0) {
                container.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: var(--text-muted);">
                        <i class="far fa-bookmark" style="font-size: 50px; margin-bottom: 15px; color: var(--border-color);"></i>
                        <p style="font-size: 16px; font-weight: 600;">Belum ada komik yang dibookmark.</p>
                        <p style="font-size: 13px; margin-top: 5px;">Silakan jelajahi komik dan simpan favoritmu di halaman detail!</p>
                    </div>
                `;
                return;
            }

            let htmlContent = '';
            bookmarks.forEach(item => {
                htmlContent += `
                    <div class="p-card-list" style="background: var(--bg-card); padding: 15px; border-radius: 8px; border: 1px solid var(--border-color);">
                        <a href="${item.url}" style="flex-shrink: 0;">
                            <img src="${item.cover}" alt="${item.title}" class="p-card-thumb" style="width: 90px; height: 130px; border-radius: 6px; object-fit: cover;">
                        </a>
                        <div class="p-card-info" style="display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <a href="${item.url}" style="text-decoration: none; color: inherit;">
                                    <h3 style="font-size: 15px; margin-bottom: 8px; color: #fff;">${item.title}</h3>
                                </a>
                                <div class="p-card-stats" style="display: flex; gap: 10px; font-size: 12px; color: var(--text-muted); margin-bottom: 10px;">
                                    <span><i class="fas fa-star" style="color: #f1c40f;"></i> ${item.rating}</span>
                                </div>
                            </div>
                            <button onclick="removeBookmark('${item.id}')" style="background: rgba(255, 59, 92, 0.15); color: #ff3b5c; border: 1px solid rgba(255, 59, 92, 0.3); padding: 6px 12px; border-radius: 4px; font-size: 12px; font-weight: 600; cursor: pointer; width: max-content;">
                                <i class="fas fa-trash-alt"></i> Hapus
                            </button>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = htmlContent;
        });

        // Fungsi buat hapus item dari halaman bookmark langsung
        function removeBookmark(id) {
            let bookmarks = JSON.parse(localStorage.getItem('yuu_bookmarks')) || [];
            bookmarks = bookmarks.filter(item => item.id !== id);
            localStorage.setItem('yuu_bookmarks', JSON.stringify(bookmarks));
            location.reload(); // Refresh halaman biar list-nya ter-update
        }
    </script>
      <script src="/script.js"></script>
</body>
</html>
