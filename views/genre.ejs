<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Genre - Ngomikuy</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-left">
                  <a href="/" class="logo">
    <img src="/Ngomikuy.png" alt="Ngomikuy" class="logo-img">
</a>
        </div>
        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/pustaka">Pustaka</a></li>
            <li><a href="/genre" class="active">Genre</a></li>
          <li><a href="/bookmark">Bookmark</a></li>
        </ul>
        <div class="nav-right">
            <button class="icon-btn"><i class="fas fa-search"></i></button>
            <a href="/member/dashboard" class="icon-btn"><i class="far fa-user"></i></a>
            <button class="icon-btn menu-btn"><i class="fas fa-bars"></i></button>
        </div>
    </nav>

    <!-- KONTEN DAFTAR GENRE -->
    <div class="container" style="margin-top: 40px;">
        <div class="section-header-flex" style="margin-bottom: 30px;">
            <h3><i class="fas fa-tags" style="color: var(--accent-green);"></i> Semua Genre Komik</h3>
        </div>

        <div class="genre-grid-page" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px;">
            <% if (genres && genres.length > 0) { %>
                <% genres.forEach(function(g) { %>
                    <!-- Ketika diklik, langsung lempar ke /pustaka?genre_include=slug_genre -->
                    <a href="/pustaka?genre_include=<%= g.slug %>" class="genre-card-item" style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 20px; border-radius: 8px; text-decoration: none; display: flex; justify-content: space-between; align-items: center; transition: 0.2s;">
                        <span style="color: #fff; font-weight: 600; font-size: 15px;"><%= g.name %></span>
                        <i class="fas fa-arrow-right" style="color: var(--text-muted); font-size: 12px;"></i>
                    </a>
                <% }); %>
            <% } else { %>
                <p style="color: var(--text-muted);">Genre tidak tersedia.</p>
            <% } %>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="site-footer" style="margin-top: 60px;">
        <div class="footer-logo">
             <a href="/" class="logo">
    <img src="/Ngomikuy.png" alt="Ngomikuy" class="logo-img">
</a>
        </div>
        <p class="footer-tagline">Read Comics, manga, manhua, manhwa swiftly: Ngomikuy, your ultimate library.</p>
        <hr class="footer-divider">
        <div class="footer-bottom">
            <p><i class="fas fa-heart" style="color: var(--accent-green);"></i> Made with passion</p>
            <p>&copy; 2026 All Rights Reserved</p>
        </div>
    </footer>

    <style>
        .genre-card-item:hover {
            border-color: var(--accent-green);
            transform: translateY(-3px);
            background: rgba(255, 183, 197, 0.05);
        }
        .genre-card-item:hover span {
            color: var(--accent-green);
        }
    </style>
</body>
</html>
