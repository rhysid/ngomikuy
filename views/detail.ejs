const axios = require('axios');

// Fungsi buat ngambil list semua genre
exports.fetchGenresData = async () => {
    try {
        const genresUrl = 'https://www.sankavollerei.web.id/comic/shinigami/genres';
        const response = await axios.get(genresUrl);
        const genresData = response.data?.data || [];

        // Return JSON dengan key 'genres' biar klop sama EJS lu
        return {
            status: 'success',
            data: {
                genres: genresData // Dipakai di <% genres.forEach(function(g) { %>
            }
        };
    } catch (error) {
        console.error("Error saat fetch Genre:", error.message);
        return { status: 'error', message: error.message };
    }
};
// Fungsi buat ngambil data pencarian (Pustaka) beserta semua data filter-nya
exports.fetchPustakaData = async (queryParams) => {
    try {
        // Ambil nilai dari query URL atau set default-nya
        const page = queryParams.page || 1;
        const pageSize = 24;
        const query = queryParams.q || '';
        const genreInclude = queryParams.genre_include || '';
        const genreIncludeMode = queryParams.genre_include_mode || 'or';
        const sort = queryParams.sort || 'popular';
        const type = queryParams.type || '';
        const format = queryParams.format || '';
        const author = queryParams.author || '';
        const artist = queryParams.artist || '';

        // 1. Susun URL Advanced Search utama
        let searchApiUrl = `https://www.sankavollerei.web.id/comic/shinigami/advanced-search?page=${page}&page_size=${pageSize}&sort=${sort}`;

        if (query) searchApiUrl += `&q=${encodeURIComponent(query)}`;
        if (genreInclude) searchApiUrl += `&genre_include=${encodeURIComponent(genreInclude)}&genre_include_mode=${genreIncludeMode}`;
        if (type) searchApiUrl += `&type=${encodeURIComponent(type)}`;
        if (format) searchApiUrl += `&format=${encodeURIComponent(format)}`;
        if (author) searchApiUrl += `&author=${encodeURIComponent(author)}`;
        if (artist) searchApiUrl += `&artist=${encodeURIComponent(artist)}`;

        // 2. Siapkan Endpoint untuk dropdown filter
        const genresUrl = 'https://www.sankavollerei.web.id/comic/shinigami/genres';
        const typesUrl = 'https://www.sankavollerei.web.id/comic/shinigami/types';
        const formatsUrl = 'https://www.sankavollerei.web.id/comic/shinigami/formats';
        const authorsUrl = 'https://www.sankavollerei.web.id/comic/shinigami/authors?q=&page=1';
        const artistsUrl = 'https://www.sankavollerei.web.id/comic/shinigami/artists?q=&page=1';

        // 3. Fetch semuanya secara paralel
        const [searchRes, genresRes, typesRes, formatsRes, authorsRes, artistsRes] = await Promise.all([
            axios.get(searchApiUrl),
            axios.get(genresUrl).catch(() => ({ data: { data: [] } })),
            axios.get(typesUrl).catch(() => ({ data: { data: [] } })),
            axios.get(formatsUrl).catch(() => ({ data: { data: [] } })),
            axios.get(authorsUrl).catch(() => ({ data: { data: [] } })),
            axios.get(artistsUrl).catch(() => ({ data: { data: [] } }))
        ]);

        // 4. Return JSON dengan struktur KEY yang pas sama EJS lu
        return {
            status: 'success',
            data: {
                komik: searchRes.data?.data || [],
                pagination: searchRes.data?.pagination || {},
                genres: genresRes.data?.data || [],
                types: typesRes.data?.data || [],
                formats: formatsRes.data?.data || [],
                // Filter author & artist yang ada ID-nya aja biar nggak error pas di-loop EJS
                authors: (authorsRes.data?.data || []).filter(item => item.id),
                artists: (artistsRes.data?.data || []).filter(item => item.id),
                // Kirim balik query saat ini biar EJS tau filter apa yang lagi aktif
                currentQuery: queryParams 
            }
        };

    } catch (error) {
        console.error("Error saat fetch Pustaka:", error.message);
        return { status: 'error', message: error.message };
    }
};
// Fungsi buat ngambil data 1 Chapter (beserta gambar, navigasi, dan list chapter lain)
exports.fetchReadChapter = async (chapterId) => {
    try {
        // 1. Fetch data chapter utama (buat dapetin id manga dan list gambar)
        const readUrl = `https://www.sankavollerei.web.id/comic/shinigami/read/${chapterId}`;
        const readRes = await axios.get(readUrl);
        const readData = readRes.data?.data;

        // Kalau chapter nggak ketemu di server sumber
        if (!readData) {
            return { status: 'not_found', message: 'Data chapter tidak ditemukan anjir.' };
        }

        const mangaId = readData.manga_id;

        // 2. Fetch Detail Manga (untuk judul) & List Chapter (untuk Dropdown) secara paralel
        const detailUrl = `https://www.sankavollerei.web.id/comic/shinigami/detail/${mangaId}`;
        const chaptersUrl = `https://www.sankavollerei.web.id/comic/shinigami/chapters/${mangaId}`;

        const [detailRes, chaptersRes] = await Promise.all([
            // Pake .catch supaya kalo gagal fetch detail/list, gambar chapter tetep bisa ditampilin
            axios.get(detailUrl).catch(() => ({ data: { data: {} } })),
            axios.get(chaptersUrl).catch(() => ({ data: { data: [] } }))
        ]);

        const mangaDetail = detailRes.data?.data || {};
        const chaptersList = chaptersRes.data?.data || [];

        // 3. Return JSON dengan key yang langsung klop sama file EJS lu
        return {
            status: 'success',
            data: {
                read: readData,       // Dipakai buat nampilin <%= read.images %>, <%= read.prev_chapter %>, dll
                manga: mangaDetail,   // Dipakai buat <%= manga.title %> dan <%= manga.cover %>
                chapters: chaptersList // Dipakai buat looping dropdown <% chapters.forEach(...) %>
            }
        };

    } catch (error) {
        console.error(`Error Fetch Read Chapter ID ${chapterId}:`, error.message);
        return { status: 'error', message: error.message };
    }
};

// Tambahin fungsi ini di bagian bawah file
exports.fetchMangaDetail = async (mangaId) => {
    try {
        const detailUrl = `https://www.sankavollerei.web.id/comic/shinigami/detail/${mangaId}`;
        const chaptersUrl = `https://www.sankavollerei.web.id/comic/shinigami/chapters/${mangaId}`;

        // Fetch kedua API secara bersamaan (paralel)
        // Pake .catch biar kalo API chapter error, detail tetep jalan
        const [detailRes, chaptersRes] = await Promise.all([
            axios.get(detailUrl),
            axios.get(chaptersUrl).catch(err => ({ data: { data: [], pagination: {} } }))
        ]);

        // Ekstrak data
        const mangaData = detailRes.data?.data;
        const chaptersData = chaptersRes.data?.data || [];
        const paginationData = chaptersRes.data?.pagination || {};

        // Kalau ID komiknya ngaco atau gak nemu
        if (!mangaData) {
            return { status: 'not_found', message: 'Data komik tidak ditemukan di server.' };
        }

        // Return JSON dengan key yang langsung klop sama EJS lu
        return {
            status: 'success',
            data: {
                manga: mangaData,       // Dipakai buat <%= manga.title %>, <%= manga.cover %>, dll
                chapters: chaptersData, // Dipakai buat <% chapters.forEach(...) %>
                pagination: paginationData // Dipakai buat <%= pagination.total_record %>
            }
        };

    } catch (error) {
        console.error(`Error Fetch Detail Manga ID ${mangaId}:`, error.message);
        return { status: 'error', message: error.message };
    }
};
exports.fetchHomepageData = async () => {
    try {
        // 1. Setup URL (Sesuai request lu, random page sampai 50 untuk Hero)
        const randomPage = Math.floor(Math.random() * 50) + 1;
        const baseUrl = 'https://www.sankavollerei.web.id/comic/shinigami';
        
        const heroUrl = `${baseUrl}/latest?page=${randomPage}`;
        const popularUrl = `${baseUrl}/popular?page=1&page_size=16`;
        const latestUrl = `${baseUrl}/latest?page=1&page_size=24`;
        const recommendedUrl = `${baseUrl}/recommended?page=1`;

        // 2. Fetch API tahap pertama secara PARALEL
        const [heroRes, popularRes, latestRes, recommendedRes] = await Promise.all([
            axios.get(heroUrl),
            axios.get(popularUrl),
            axios.get(latestUrl),
            axios.get(recommendedUrl)
        ]);

        // Ekstrak data
        const rawHero = heroRes.data?.data || heroRes.data || [];
        const popularToday = popularRes.data?.data || popularRes.data || [];
        const rawLatest = latestRes.data?.data || latestRes.data || [];
        const topSeries = recommendedRes.data?.data || recommendedRes.data || [];

        // Logic Hero: Ambil hanya 3 item pertama
        const heroBanners = rawHero.slice(0, 3);

        // 3. Logic Latest Updates & Chapters: Fetch chapter secara paralel
        const latestUpdatesPromises = rawLatest.map(async (manga) => {
            try {
                // Asumsi ID manga tersimpan di field 'id', 'manga_id', atau 'slug'
                const mangaId = manga.manga_id || manga.id || manga.slug; 
                
                // Fetch chapter berdasarkan ID
                const chapterRes = await axios.get(`${baseUrl}/chapters/${mangaId}`);
                const chaptersData = chapterRes.data?.data || chapterRes.data || [];

                // Ambil 3 chapter terakhir/teratas lalu gabungkan ke object manga
                manga.latest_chapters = chaptersData.slice(0, 3);
            } catch (error) {
                console.error(`Gagal mengambil chapter untuk ID: ${manga.manga_id || manga.id}`, error.message);
                manga.latest_chapters = []; // Fallback agar tidak crash jika API 1 manga error
            }
            return manga;
        });

        // Tunggu semua proses fetch chapter selesai
        const latestUpdates = await Promise.all(latestUpdatesPromises);

        // 4. Return data JSON dengan KEY yang persis sama kayak yang dipanggil di EJS lu
        return {
            status: 'success',
            data: {
                heroBanners: heroBanners,       // Dipakai di <% heroBanners.forEach... %>
                popularToday: popularToday,     // Dipakai di <% popularToday.forEach... %>
                latestUpdates: latestUpdates,   // Dipakai di <% latestUpdates.forEach... %>
                topSeries: topSeries            // Dipakai di <% topSeries.forEach... %>
            }
        };

    } catch (error) {
        console.error("Error saat fetch data Homepage:", error.message);
        return { status: 'error', message: error.message };
    }
};
